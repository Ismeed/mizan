  heir_instance_id String
  heir_instance    HeirInstance @relation(fields: [heir_instance_id], references: [id])
  display_name     String?
  created_at       DateTime     @default(now())

  @@map("heir_person_instances")
}

model HeirNormalizationRecord {
  id                  String   @id @default(cuid())
  original_input      String
  language_tag        String
  madhhab             String?
  status              String   // "RESOLVED" | "AMBIGUOUS" | "UNSUPPORTED" | "REVIEW_REQUIRED"
  resolved_heir_id    String?
  matched_alias_id    String?
