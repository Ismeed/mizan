  hawl_requirement    String                          // ZakatHawlRequirement
  is_liability        Boolean                         @default(false)
  is_user_input       Boolean                         @default(true)
  allows_item_breakdown Boolean                       @default(false)
  requires_irrigation_method Boolean                  @default(false)
