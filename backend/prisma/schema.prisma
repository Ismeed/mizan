  id                      String   @id @default(cuid())
  ai_evidence_context_id  String   @unique
  redacted_pii_count      Int      @default(0)
  redacted_fields_json    Json
  filtered_at             DateTime @default(now())

  @@map("ai_privacy_filter_records")
}

model AIRetrievalTraceDb {
  id                String   @id @default(cuid())
  retrieval_trace_id String  @unique
  retrieval_mode    String
  query_source      String   @default("SERVER_GENERATED")
  retrieved_records Json
  retrieved_at      DateTime @default(now())

  @@map("ai_retrieval_traces")
}

model AIPromptInjectionEventDb {
  id               String   @id @default(cuid())
  user_id          String
  raw_prompt       String
  detected_pattern String
  action_taken     String   @default("REJECTED")
  logged_at        DateTime @default(now())

  @@map("ai_prompt_injection_events")
}

model AIContextValidationResultDb {
  id                      String   @id @default(cuid())
  ai_evidence_context_id  String
  is_valid                Boolean
  gate_results_json       Json
  errors_json             Json
  validated_at            DateTime @default(now())

  @@map("ai_context_validation_results")
}






