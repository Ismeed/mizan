// ─── Phase 8: Canonical Zakat Category Registry Models ───────────────────────

/// Canonical Zakat category entity record
model ZakatCategoryEntity {
  id                  String                          @id @default(cuid())
  category_id         String                          // CanonicalZakatCategoryId — e.g. "GOLD", "CASH_AND_BANK"
  version             String                          @default("1.0.0")
  schema_version      String                          @default("1.0.0")
  canonical_name      String
  domain              String                          // ZakatCategoryDomain
  value_type          String                          // ZakatValueType
  nisab_base          String                          // ZakatNisabBase
  hawl_requirement    String                          // ZakatHawlRequirement
  is_liability        Boolean                         @default(false)
  is_user_input       Boolean                         @default(true)
  allows_item_breakdown Boolean                       @default(false)
  requires_irrigation_method Boolean                  @default(false)
  group_memberships   String[]                        // Array of CanonicalZakatGroupId strings
  label_key           String
  description_key     String
  report_label_key    String
  placeholder_key     String?
  governance_status   String                          @default("DRAFT")
  effective_from      DateTime
  effective_until     DateTime?
  content_checksum    String
  created_at          DateTime                        @default(now())
  created_by          String                          @default("SYSTEM_BASELINE")
  updated_at          DateTime                        @updatedAt
  updated_by          String                          @default("SYSTEM_BASELINE")

  localizations       ZakatCategoryLocalization[]
  aliases             ZakatCategoryAlias[]
  madhhab_support     ZakatCategoryMadhhabSupport[]
  audit_events        ZakatCategoryAuditEvent[]

  @@unique([category_id, version])
  @@index([category_id])
  @@index([domain])
  @@index([governance_status])
  @@map("zakat_category_entities")
}

/// Per-language localization record for a Zakat category entity
model ZakatCategoryLocalization {
  id                    String              @id @default(cuid())
  zakat_category_entity_id String
  entity                ZakatCategoryEntity @relation(fields: [zakat_category_entity_id], references: [id], onDelete: Cascade)
  category_id           String
  language_code         String              // SupportedZakatLanguage
  label                 String
  description           String
  report_label          String
  input_placeholder     String?
  educational_description String?
  arabic_term           String?
  review_status         String              @default("DRAFT")
  reviewed_by           String?
  created_at            DateTime            @default(now())
  updated_at            DateTime            @updatedAt

  @@unique([zakat_category_entity_id, language_code])
  @@index([category_id, language_code])
  @@map("zakat_category_localizations")
}

/// Alias-to-canonical-ID mapping for Zakat categories
model ZakatCategoryAlias {
  id                    String              @id @default(cuid())
  zakat_category_entity_id String
  entity                ZakatCategoryEntity @relation(fields: [zakat_category_entity_id], references: [id], onDelete: Cascade)
  alias_text            String
  target_category_id    String              // CanonicalZakatCategoryId
  alias_type            String              // ZakatAliasType
  matching_mode         String              // ZakatAliasMatchingMode
  language_code         String?
  is_deprecated         Boolean             @default(false)
  migration_note        String?
  created_at            DateTime            @default(now())

  @@unique([alias_text, target_category_id, alias_type])
  @@index([alias_text])
  @@index([target_category_id])
  @@map("zakat_category_aliases")
}

/// Per-madhhab support status for a Zakat category entity
model ZakatCategoryMadhhabSupport {
  id                    String              @id @default(cuid())
  zakat_category_entity_id String
  entity                ZakatCategoryEntity @relation(fields: [zakat_category_entity_id], references: [id], onDelete: Cascade)
  category_id           String
  madhhab               String              // "HANAFI" | "MALIKI" | "SHAFII" | "HANBALI" | "JAFARI"
  input_support_status  String              // ZakatCategoryInputSupportStatus
  zakatable_override    Boolean?
  nisab_base_override   String?
  scholar_notes         String?
  created_at            DateTime            @default(now())
  updated_at            DateTime            @updatedAt

  @@unique([zakat_category_entity_id, madhhab])
  @@index([category_id, madhhab])
  @@map("zakat_category_madhhab_support")
}

/// Canonical Zakat category group definition
model ZakatCategoryGroup {
  id               String   @id @default(cuid())
  group_id         String   @unique  // CanonicalZakatGroupId
  version          String   @default("1.0.0")
  canonical_name   String
  label_key        String
  description_key  String
  membership_mode  String   @default("STATIC")
  display_order    Int      @default(0)
  is_collapsible   Boolean  @default(true)
  status           String   @default("DRAFT")
  created_at       DateTime @default(now())
  updated_at       DateTime @updatedAt

  members          ZakatCategoryGroupMembership[]

  @@index([group_id])
  @@map("zakat_category_groups")
}

/// Group membership entry linking a Zakat category to a group
model ZakatCategoryGroupMembership {
  id              String             @id @default(cuid())
  group_id        String
  group           ZakatCategoryGroup @relation(fields: [group_id], references: [id], onDelete: Cascade)
  category_id     String             // CanonicalZakatCategoryId
  display_order   Int                @default(0)
  is_mandatory    Boolean            @default(true)
  madhhab_scope   String[]           // Empty = all madhhabs

  @@unique([group_id, category_id])
  @@index([category_id])
  @@map("zakat_category_group_memberships")
}

/// Per-calculation Zakat asset entry keyed by canonical category ID
model ZakatAssetInstance {
  id                    String          @id @default(cuid())
  calculation_id        String
  zakat_calculation     ZakatCalculation @relation(fields: [calculation_id], references: [id], onDelete: Cascade)
  category_id           String          // CanonicalZakatCategoryId
  category_version      String          @default("1.0.0")
  amount                Float
  unit                  String          // currency code, "grams", "head", "kg"
  currency_code         String?
  raw_input_text        String?
  irrigation_method     String?         // "RAIN_FED" | "IRRIGATION"
  hawl_start_date       DateTime?
  hawl_status           String?         // HawlStatus
  input_source          String          @default("USER_ENTRY")
  user_confirmed        Boolean         @default(false)
  is_liability          Boolean         @default(false)
  breakdown_json        Json?           // Array of ZakatAssetBreakdownItem
  recorded_at           DateTime        @default(now())

  @@index([calculation_id])
  @@index([category_id])
  @@map("zakat_asset_instances")
}

/// Normalization audit log for Zakat category input resolution
model ZakatCategoryNormalizationRecord {
  id                     String   @id @default(cuid())
  calculation_id         String?
  raw_input_text         String
  resolution_status      String   // ZakatNormalizationStatus
  resolved_category_id   String?  // CanonicalZakatCategoryId
  candidate_category_ids String[] // For AMBIGUOUS status
  matched_alias_text     String?
  explanation            String?
  madhhab                String?
  language_tag           String?
  created_at             DateTime @default(now())

  @@index([calculation_id])
  @@index([resolved_category_id])
  @@map("zakat_category_normalization_records")
}

/// Governance lifecycle audit events for Zakat category entities
model ZakatCategoryAuditEvent {
  id                       String              @id @default(cuid())
  zakat_category_entity_id String
  entity                   ZakatCategoryEntity @relation(fields: [zakat_category_entity_id], references: [id])
  category_id              String
  event_type               String              // "CREATED" | "SUBMITTED_REVIEW" | "APPROVED" | "PUBLISHED" | "UPDATED" | "DEPRECATED"
  actor                    String
  metadata_json            Json?
  timestamp                DateTime            @default(now())

  @@index([category_id])
  @@map("zakat_category_audit_events")
}

// ─── Phase 9: Livestock Zakat Schedule Models ───────────────────────────────

model LivestockSchedule {
