{
  "name": "mizan-backend",
  "version": "1.0.0",
  "description": "MIZAN backend - Islamic Financial Assistant API",
  "main": "dist/server.js",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "nodemon src/server.ts",
    "build": "tsc",
    "test": "jest",
    "lint": "eslint src/**/*.ts",
    "format": "prettier --write src/**/*.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "knowledge:validate": "ts-node scripts/knowledge/validate.ts",
    "knowledge:check-links": "ts-node scripts/knowledge/check-links.ts",
    "knowledge:check-provenance": "ts-node scripts/knowledge/check-provenance.ts",
    "knowledge:check-checksums": "ts-node scripts/knowledge/check-checksums.ts",
    "knowledge:generate-manifest": "ts-node scripts/knowledge/generate-manifest.ts",
    "knowledge:index-approved": "ts-node scripts/knowledge/index-approved.ts",
    "knowledge:publish": "ts-node scripts/knowledge/publish.ts",
    "knowledge:audit": "ts-node scripts/knowledge/audit.ts",
    "knowledge:report": "ts-node scripts/knowledge/report.ts",
    "profile:migrate": "ts-node scripts/migrate-profiles.ts",
    "livestock:validate": "ts-node scripts/livestock/validate-schedules.ts"
  },

  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.22.0",
    "bcrypt": "^5.1.0",
    "cookie-signature": "^1.2.2",
    "cors": "^2.8.5",
    "data-uri-to-buffer": "^8.0.0",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.8.0",
    "firebase-admin": "^11.10.1",
    "helmet": "^7.0.0",
    "joi": "^17.9.2",
    "jsonwebtoken": "^9.0.1",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.4",
    "openai": "^4.0.0",
    "puppeteer": "^21.0.0",
    "redis": "^4.6.7",
    "winston": "^3.10.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^5.0.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^4.17.17",
    "@types/jest": "^29.5.3",
    "@types/jsonwebtoken": "^9.0.2",
    "@types/morgan": "^1.9.4",
    "@types/node": "^20.4.5",
    "@types/nodemailer": "^6.4.8",
    "@typescript-eslint/eslint-plugin": "^6.2.0",
    "@typescript-eslint/parser": "^6.2.0",
    "eslint": "^8.45.0",
    "jest": "^29.6.1",
    "nodemon": "^3.0.1",
    "prettier": "^3.0.0",
    "prisma": "^5.0.0",
    "ts-jest": "^29.1.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.1.6"
  }
}
