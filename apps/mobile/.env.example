# MIZAN Mobile — Environment Configuration
# Copy this file to .env and fill in the values.
# Never commit .env to source control.

# ── Express Backend ─────────────────────────────────────────────────────────
EXPO_PUBLIC_API_URL=http://localhost:3000/api
EXPO_PUBLIC_ENVIRONMENT=development

# ── Supabase (public/publishable — safe for Expo) ───────────────────────────
# These are Expo-specific prefixes (NOT Next.js NEXT_PUBLIC_)
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# ── Do NOT add to this file ──────────────────────────────────────────────────
# SUPABASE_SECRET_KEY        → Server only (never in Expo)
# SUPABASE_SERVICE_ROLE_KEY  → Server only (never in Expo)
# GOOGLE_CLIENT_SECRET       → Never in Expo app
# SMTP_PASSWORD              → Never in Expo app
